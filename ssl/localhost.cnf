# Leaf certificate used by `serve --secure`, issued by the Firestitch Development Root CA.
#
# Regenerate with: node scripts/ssl.js generate
#
# Add hostnames to [alt_names] as needed -- anything under local.firestitch.com or
# localhost is already inside the CA's name constraints. A NEW top-level domain also
# needs a matching entry in ca.cnf, which means reissuing the CA and re-trusting it
# on every machine, so prefer *.local.firestitch.com.

[req]
distinguished_name = dn
req_extensions     = leaf_ext
prompt             = no
default_md         = sha256

[dn]
C  = CA
ST = Ontario
L  = Toronto
O  = Firestitch
CN = localhost

[leaf_ext]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
subjectAltName         = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = *.localhost
DNS.3 = local.firestitch.com
DNS.4 = *.local.firestitch.com
IP.1  = 127.0.0.1
IP.2  = ::1
